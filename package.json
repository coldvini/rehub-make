{
  "name": "lumen",
  "productName": "Lumen",
  "version": "1.1.0",
  "description": "Generate stunning, one-of-a-kind wallpapers and set them in one click. For macOS and Windows.",
  "main": "main.js",
  "author": "Vishantuwuw",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.vishantuwuw.lumen",
    "productName": "Lumen",
    "copyright": "Copyright © 2026 Vishantuwuw",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "wallpaper-preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Lumen-${version}-mac.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Lumen uses System Events to set your desktop wallpaper."
      }
    },
    "dmg": {
      "title": "Lumen",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Lumen-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Lumen-${version}-portable.exe"
    }
  }
}
