{
  "name": "nocturne",
  "productName": "Nocturne",
  "version": "1.0.0",
  "description": "A beautiful, distraction-free focus timer for macOS and Windows.",
  "main": "main.js",
  "author": "Vishantuwuw",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.vishantuwuw.nocturne",
    "productName": "Nocturne",
    "copyright": "Copyright © 2026 Vishantuwuw",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "artifactName": "Nocturne-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Nocturne",
      "contents": [
        { "x": 140, "y": 190 },
        { "x": 400, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Nocturne-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Nocturne-${version}-portable.exe"
    }
  }
}
